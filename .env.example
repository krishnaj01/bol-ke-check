# Copy to .env and fill in. Never commit .env.

# Gnani speech APIs (https://docs.gnani.ai/api/introduction/quick-start)
GNANI_API_KEY=
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_FORMAT=codemix
# Docs warn keyterms can reduce accuracy on some audio; compare before enabling.
GNANI_STT_KEYTERMS=0
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Nalini
# Gnani calls in flight at once. The current account allows 1; check the rate card.
GNANI_MAX_CONCURRENT=1

# Evon via any OpenAI-compatible server (vLLM, Ollama at http://host:11434/v1).
# Leave LLM_BASE_URL blank to run rules only; reports are then marked "partial".
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gnani-evon-v3.3
LLM_MIN_CONFIDENCE=0.5
LLM_TIMEOUT_SEC=180

# 1 = canned responses, no keys or credits needed
GNANI_MOCK=1

MAX_UPLOAD_MB=100
MAX_AUDIO_SEC=180
# Stop accepting jobs after this many seconds of billed Prisma audio. 0 = no limit.
CREDIT_GUARD_SECONDS=3600

DATABASE_URL=sqlite:///./bolkecheck.db
CORS_ORIGINS=http://localhost:5173
